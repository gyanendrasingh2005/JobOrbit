# Server Environment Variables (Copy to Vercel Project Settings > Environment Variables)

PORT=8000
NODE_ENV=production
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.fjzbtd2.mongodb.net/career_connect_new"
SECRET_KEY=your-jwt-secret-key-at-least-32-chars
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET_KEY=your-cloudinary-secret-key
CLOUDINARY_NAME=your-cloudinary-cloud-name
FRONTEND_URL=https://your-frontend-project.vercel.app

# Gmail Email Service (Choose EITHER App Password OR OAuth2):
# Option A: Gmail App Password (Simpler & Recommended - 16-char code from https://myaccount.google.com/apppasswords)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password

# Option B: Gmail OAuth2 (Google Cloud Console with Gmail API enabled)
CLIENT_ID=your-google-oauth-client-id
CLIENT_SECRET=your-google-oauth-client-secret
REFRESH_TOKEN=your-google-oauth-refresh-token

# Optional: Set to true for mock email delivery in development / testing
MOCK_EMAIL=false
